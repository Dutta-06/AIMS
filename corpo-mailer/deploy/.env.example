# Copy to deploy/.env on the server and fill in. Keep it private (chmod 600): it holds your secrets.
# Do not put quotes around values, and avoid a literal $ in a value.

# ---- Where it lives -------------------------------------------------------------------------
# The domain name that points at this server (an A record). Needed for https and for Google.
DOMAIN=corpo.example.com
# The website that is allowed to call this backend: your GitHub Pages address, no path.
CORS_ORIGINS=["https://your-github-username.github.io"]
# Where Google sends the browser back to. Must match the one in the Google console exactly.
GOOGLE_REDIRECT_URI=https://corpo.example.com/api/v1/auth/google/callback

# ---- Secrets: make each with `openssl rand -hex 32` ------------------------------------------
# The database password (letters and digits only, so it is safe inside a connection address).
DB_PASSWORD=
# Signs the sign-in sessions. Set it, or everyone is signed out whenever the backend restarts.
SESSION_SECRET=

# ---- Who may sign in --------------------------------------------------------------------------
# Google accounts allowed to use the site, comma-separated. The backend refuses to start without it.
ALLOWED_EMAILS=you@gmail.com,teammate@dtu.ac.in
# From the one-time Google setup (docs/GMAIL_SETUP.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- The AI and your event --------------------------------------------------------------------
OPENROUTER_API_KEY=
EVENT_NAME=brAInwave 3
EVENT_PITCH=brAInwave 3 is a hackathon hosted at Delhi Technological University (DTU). We are looking for corporate sponsors.
SENDER_SIGNATURE=
SMTP_FROM_NAME=brAInwave Team

# ---- Optional ---------------------------------------------------------------------------------
# Lets Discovery search the web for sponsor pages (Brave Search API, free tier).
SEARCH_API_KEY=
# How often replies are checked, in seconds (0 = only when you press the button).
IMAP_POLL_SECONDS=300
