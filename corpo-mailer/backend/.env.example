# Required
SECRET_KEY=change-me-to-a-long-random-string
APP_PASSWORD=shared-team-login-password

# Defaults to a local SQLite file; use postgresql+psycopg://user:pass@host/db in production
DATABASE_URL=sqlite:///./corpo_mailer.db

# Gmail sender (use an app password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=brAInwave Team

CORS_ORIGINS=["http://localhost:3000"]
