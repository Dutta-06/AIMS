# Keep the backend on localhost unless you set ALLOWED_EMAILS below. With ALLOWED_EMAILS set, only
# those Google accounts can use it ("Sign in with Google"). Browsers may only call this backend from
# the websites listed in CORS_ORIGINS (the frontend).

# SQLite file by default (fine for trying it out). For real use, PostgreSQL:
#   local:  docker compose up -d db   (see ../docker-compose.yml)
#   hosted: paste the provider's connection string (postgres:// and postgresql:// both work)
DATABASE_URL=sqlite:///./corpo_mailer.db
# DATABASE_URL=postgresql://corpo:corpo@localhost:5432/corpo_mailer

# Google: one OAuth client does two jobs, signing people in to the website and connecting the
# mailbox the team sends from ("Connect Gmail" in Settings). Nothing here is a mail password.
# One-time setup in Google Cloud: see ../docs/GMAIL_SETUP.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Who may use the site: these Google accounts, comma-separated. Leave empty only while the backend
# can be reached from your own computer alone (then there is no sign-in at all).
ALLOWED_EMAILS=
# Optional: signs the session tokens. Empty = random each start (restarting signs everyone out).
SESSION_SECRET=
SESSION_HOURS=12

# Sending (the mailbox itself is connected in the app, not here)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_NAME=brAInwave Team

# LLM drafting (https://openrouter.ai/keys). Models are tried in order.
OPENROUTER_API_KEY=
# Requests rotate round-robin across these; a failing or rate-limited model falls through to the next.
# Get exact IDs with:  uv run python scripts/list_free_models.py nemotron gemma
LLM_MODELS=["nvidia/nemotron-3-ultra-550b-a55b:free","nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free","google/gemma-4-26b-a4b-it:free","google/gemma-4-31b-it:free"]

# Optional: lets Discovery search the web for sponsor pages (Brave Search API, free tier).
# Only the words you type into the search box are sent to it.
SEARCH_API_KEY=

# Facts the AI may use about your event. Fill in dates, venue, audience, sponsor tiers.
EVENT_NAME=brAInwave 3
EVENT_PITCH=brAInwave 3 is a hackathon hosted at Delhi Technological University (DTU). We are looking for corporate sponsors.
SENDER_SIGNATURE=

# Reply tracking (IMAP), as the connected Gmail account. Enable IMAP in Gmail's settings.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_FOLDER=INBOX
IMAP_POLL_SECONDS=300     # 0 = only check when you press the button
IMAP_LOOKBACK_DAYS=14     # how far back to look the first time

# Websites allowed to call this backend. Add your GitHub Pages address (no path) if you host there.
# CORS_ORIGINS=["http://localhost:3000","https://your-username.github.io"]
